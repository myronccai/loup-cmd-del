@mode(host.dual)

# Unit tests for del's whole command line (cli.app.run): exit statuses for
# help, version, usage errors, and a real deletion under build/tmp/. These
# tests print the program's normal output and error messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from io.fs import (createDir, writeText, removeDir, isDir, isFile);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_usage_errors_fail(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "no operand");
    expectEq(run(["/A:Z", "x"]), EXIT_FAILURE, "bad attribute");
}

func test_delete(): void {
    let root = "build/tmp/app_del";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    writeText(root + "/t.txt", "tests pass\n");
    expectEq(run([root + "\\t.txt"]), EXIT_OK, "deleted");
    expect(!isFile(root + "/t.txt"), "gone");
    expectEq(run([root + "/t.txt"]), EXIT_OK, "Could Not Find is still status 0");
    removeDir(root);
}
