@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, valid_attrs);

func test_defaults(): void {
    let opts = parse_args(["a.txt"]).unwrap();
    expect(!opts.ask_each and !opts.force and !opts.recurse and !opts.quiet, "no switches");
    expectEq(opts.attrs, "", "no /A");
    expectEq(opts.operands.join(","), "a.txt", "operand");
}

func test_switches(): void {
    let opts = parse_args(["/p", "-F", "/S/Q", "x"]).unwrap();
    expect(opts.ask_each and opts.force and opts.recurse and opts.quiet, "all four");
    expectEq(parse_args(["/AR"]).unwrap().attrs, "R", "glued");
    expectEq(parse_args(["/a:-r"]).unwrap().attrs, "-R", "colon");
    expectEq(parse_args(["/A"]).unwrap().attrs, "", "bare /A");
}

func test_bad_attribute(): void {
    expectEq(parse_args(["/A:D"]).unwrap_err(), "Parameter format not correct - \"D\".", "D is not for del");
    expect(!valid_attrs("R-"), "trailing minus");
    expect(valid_attrs("-RH"), "letters");
}

func test_paths_that_look_like_switches(): void {
    let opts = parse_args(["/tmp/x", "/sub", "/as.txt", "-x"]).unwrap();
    expectEq(opts.operands.len(), 4, "all operands");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["--", "/?"]).unwrap().help, "/? after --");
}
