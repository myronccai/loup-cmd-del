@mode(host.dual)

# Help and version text of del: what `del /?` prints (a short summary of this
# recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/del by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `del /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Delete files.",
        "",
        "DEL [/P] [/F] [/S] [/Q] [/A[[:]attrs]] name [name ...]",
        "ERASE is the same command.",
        "",
        "  name      A file, a pattern with * and ?, or a directory (its files).",
        "  /P        Ask before deleting each file.",
        "  /F        Delete read-only files too.",
        "  /S        Also delete matching files in every subdirectory, and",
        "            print each file deleted.",
        "  /Q        Do not ask before deleting every file of a directory.",
        "  /A[attrs] Only files with these attributes: R = read-only,",
        "            -R = writable (a - before a letter negates it).",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
