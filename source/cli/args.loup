@mode(host.dual)

# Command-line parsing for del, with the shared Windows switch parser
# (win/switches.loup). A `/X` that is not one of del's switches is a path.

from win.messages import (msg_parameter_format);
from win.switches import (SwitchSpec, flag, optional_value, parse_switches, switch_error_message);

# The attribute letters del accepts after /A, each may be prefixed with `-`.
pub const ATTR_LETTERS: string = "RHSAILO";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub ask_each: bool;     # /P
    pub force: bool;        # /F
    pub recurse: bool;      # /S
    pub quiet: bool;        # /Q
    pub attrs: string;      # /A value, upper case ("" = every file)
    pub operands: list[string];
}

pub func del_switches(): list[SwitchSpec] {
    return [flag("P"), flag("F"), flag("S"), flag("Q"), optional_value("A", ATTR_LETTERS + "-")];
}

# Whether an /A value is made of attribute letters, each optionally
# preceded by one `-`.
pub func valid_attrs(value: string): bool {
    var pending_minus = false;
    for (ch in value.toUpperCase()) {
        if (ch == "-") {
            if (pending_minus) {
                return false;
            }
            pending_minus = true;
        } else if (ATTR_LETTERS.index_of(ch) >= 0) {
            pending_minus = false;
        } else {
            return false;
        }
    }
    return !pending_minus;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, del_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    var ask_each = false;
    var force = false;
    var recurse = false;
    var quiet = false;
    var attrs = "";
    for (sw in parsed.switches) {
        if (sw.name == "P") {
            ask_each = true;
        } else if (sw.name == "F") {
            force = true;
        } else if (sw.name == "S") {
            recurse = true;
        } else if (sw.name == "Q") {
            quiet = true;
        } else if (sw.name == "A") {
            if (!valid_attrs(sw.value)) {
                return Err(msg_parameter_format(sw.value));
            }
            attrs = sw.value.toUpperCase();
        }
    }
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        ask_each = ask_each,
        force = force,
        recurse = recurse,
        quiet = quiet,
        attrs = attrs,
        operands = parsed.operands,
    ));
}
