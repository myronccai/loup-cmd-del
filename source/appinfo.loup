@mode(host.dual)

# Application identity of del: name, version, one-line summary and exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/del by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.

pub const APP_NAME: string = "del";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Delete files (a Loup recreation of the Windows del and erase commands).";

# Exit statuses returned by main(). Like cmd.exe's del, only usage errors
# give ERRORLEVEL 1: files that are missing or cannot be deleted are
# reported, and the status stays 0.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
